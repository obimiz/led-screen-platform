# Server-only MongoDB connection string
MONGODB_URI=
# Optional: default 5000ms, capped at 30000ms. Increase only for slow networks.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Public application metadata (safe to expose in the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Lumen Display Solutions

# Use at least 32 cryptographically random characters. Server only.
AUTH_SECRET=

# Used only by `npm run seed:admin`. Remove after creating the owner.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Paystack (server secret must never be exposed or committed)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Notification email provider (optional)
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# Module 20: blank defaults to true in production and false in development.
# Set false for staging/preview and local production servers; true for the live site.
# NEXT_PUBLIC_APP_URL must be the canonical HTTP(S) origin (HTTPS in production).
ALLOW_SEARCH_INDEXING=

# Set false when the application is not behind a trusted proxy that rewrites
# x-forwarded-for/x-real-ip. The in-memory limiter then uses one safe bucket.
TRUST_PROXY_HEADERS=true
